ENVIRONMENT=development

# Content Limits
MAX_DESCRIPTION_LENGTH=2000
MIN_DESCRIPTION_LENGTH=10
RATE_LIMIT_TPM=40000

# Deployment Settings (for Vercel)
VERCEL_ENV=development