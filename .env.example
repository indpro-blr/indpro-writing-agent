# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
MODEL_NAME=gpt-4-turbo-preview
MAX_TOKENS=500
TEMPERATURE=0.7
TOP_P=0.9

# Application Settings
LOG_LEVEL=INFO
MAX_RETRIES=2
