# Streamlit Secrets Configuration Template
# This file shows you how to configure secrets in Streamlit.io
# 
# IMPORTANT: Do NOT commit this file with real values to your repository!
# Instead, configure these values in your Streamlit.io app settings under "Secrets"

[general]
# OpenAI API Key (REQUIRED)
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-your-openai-api-key-here"

# Model Configuration (OPTIONAL - has defaults)
MODEL_NAME = "gpt-4-turbo-preview"
MAX_TOKENS = "500"
TEMPERATURE = "0.7"
TOP_P = "0.9"

# Application Settings (OPTIONAL - has defaults)
MAX_RETRIES = "2"
TIMEOUT = "30"
LOG_LEVEL = "INFO"
ENVIRONMENT = "production"

# Content Limits (OPTIONAL - has defaults)
MAX_DESCRIPTION_LENGTH = "2000"
MIN_DESCRIPTION_LENGTH = "10"
RATE_LIMIT_TPM = "40000"

# Example secrets.toml structure for local development:
# Create a file called secrets.toml in the .streamlit/ directory
# with the above structure and your actual values

# For Streamlit.io deployment:
# 1. Go to your app settings on Streamlit.io
# 2. Click on "Secrets" in the left sidebar
# 3. Paste the above structure with your actual values
# 4. Click "Save"